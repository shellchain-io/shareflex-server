{
  "name": "@shareflex/server-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ShareFlex cloud API — GCE + Cloudflare R2 HLS (Mac encodes)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:name": "prisma migrate dev --name",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "probe": "tsx scripts/probe-movie.ts",
    "transcode": "tsx scripts/transcode-movie.ts",
    "add-movie": "tsx scripts/add-movie.ts",
    "add-episode": "tsx scripts/add-episode.ts",
    "publish-r2": "tsx scripts/publish-r2.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.850.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/static": "^10.1.2",
    "@fastify/type-provider-zod": "^1.0.0",
    "@prisma/adapter-better-sqlite3": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "fastify-plugin": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "prisma": "^7.9.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
