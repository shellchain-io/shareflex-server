# Environment variables declared in this file are NOT automatically loaded by Prisma.
# prisma.config.ts imports dotenv/config.

# SQLite path is relative to the server-cloud package root
DATABASE_URL="file:./data/shareflex.db"

# Fastify — 0.0.0.0 so phones / GCE public IP can reach the API
HOST="0.0.0.0"
PORT="8787"
LOG_LEVEL="warn"

# Auth — change JWT_SECRET before any real use
JWT_SECRET="dev-only-change-me-shareflex-secret-min-32-chars"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"

# Local encode staging on Mac (not the friends Mac media library)
MEDIA_ROOT="../media-cloud"

# Public R2 base (no trailing slash). When set, hlsUrl/posterUrl are absolute CDN URLs.
MEDIA_PUBLIC_BASE_URL="https://pub-xxxxxxxx.r2.dev"

# Cloudflare R2 (S3-compatible) — Mac publisher uploads HLS here
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="shareflex-media"
R2_ENDPOINT=""

# Mac: true (encode here). GCE: false (metadata API only — rejects GB video uploads).
ALLOW_LOCAL_ENCODE="true"

# Mac publisher only — after R2 upload, register catalog rows on GCE:
# PUBLISH_TARGET_URL="http://34.47.238.195:8787"
# PUBLISH_TARGET_EMAIL="owner@shareflex.local"
# PUBLISH_TARGET_PASSWORD="1234@Time"
PUBLISH_TARGET_URL=""
PUBLISH_TARGET_EMAIL=""
PUBLISH_TARGET_PASSWORD=""

# Seed owner (viewers create accounts in the app)
SEED_USER_1_EMAIL="owner@shareflex.local"
SEED_USER_1_PASSWORD="1234@Time"
SEED_USER_1_NAME="Owner"
